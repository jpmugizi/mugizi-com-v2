---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';

type Category = 'engineering' | 'career' | 'life';

type Entry = {
  title: string;
  date: Date;
  categories: Category[];
  description?: string;
  slug?: string;
  externalUrl?: string;
  externalLabel?: string;
};

const externalPosts: Entry[] = [
  {
    title: 'Data Security and Stewardship at Baza In The Age of AI',
    date: new Date('2026-03-31'),
    categories: ['engineering'],
    externalUrl: 'https://www.usebaza.com/blog/data-security-stewardship',
  },
  {
    title: 'AI & Digital Tools for Energy and Transport Challenges',
    date: new Date('2026-05-25'),
    categories: ['engineering', 'career'],
    externalUrl: 'https://jpmugizi.github.io/epra-undp-talk/',
    externalLabel: 'EPRA x UNDP 2026 Conference & Hackathon',
  },
];

const posts = await getCollection('blog', ({ data }) => !data.draft);
const localEntries: Entry[] = posts.map(p => ({
  title: p.data.title,
  date: p.data.date,
  categories: p.data.categories as Category[],
  description: p.data.description,
  slug: p.id,
}));

const entries = [...localEntries, ...externalPosts].sort(
  (a, b) => b.date.valueOf() - a.date.valueOf()
);

const counts = entries.reduce<Record<string, number>>((acc, p) => {
  for (const c of p.categories) acc[c] = (acc[c] || 0) + 1;
  return acc;
}, {});
const total = entries.length;
---

<BaseLayout title="Writing">
  <section class="lede">
    <p>Writing about building systems, navigating tech careers, and lessons learned along the way.</p>
  </section>

  <section class="filters" aria-label="Filter by topic">
    <span class="filters-label">filter</span>
    <button class="chip on" data-filter="all">all ({total})</button>
    <button class="chip" data-filter="engineering">engineering ({counts.engineering ?? 0})</button>
    <button class="chip" data-filter="career">career ({counts.career ?? 0})</button>
    <button class="chip" data-filter="life">life ({counts.life ?? 0})</button>
  </section>

  <section class="archive">
    <table class="idx" aria-label="Archive of writing">
      <thead>
        <tr>
          <th class="col-date">Date</th>
          <th class="col-title">Title</th>
          <th class="col-tag">Topic</th>
        </tr>
      </thead>
      <tbody id="archive-body">
        {entries.map((entry, i) => (
          <PostCard
            title={entry.title}
            date={entry.date}
            categories={entry.categories}
            slug={entry.slug}
            externalUrl={entry.externalUrl}
            externalLabel={entry.externalLabel}
            description={entry.description}
            index={i}
          />
        ))}
      </tbody>
    </table>
  </section>
</BaseLayout>

<style>
  .lede {
    padding: 3.5rem 0 1.75rem;
    max-width: 60ch;
  }
  .lede p {
    font-family: var(--font-serif);
    font-size: 1.3125rem;
    line-height: 1.5;
    color: var(--ink);
    margin: 0;
  }
  .lede a {
    color: var(--mark);
    border-bottom: 1px solid color-mix(in srgb, var(--mark) 50%, transparent);
  }
  .lede a:hover { border-bottom-color: var(--mark); }

  .filters {
    display: flex;
    gap: 0.625rem;
    align-items: center;
    flex-wrap: wrap;
    padding: 0.75rem 0;
    margin-bottom: 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }
  .filters-label {
    color: var(--muted);
    text-transform: uppercase;
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    margin-right: 0.25rem;
  }
  .chip {
    background: none;
    border: 1px solid var(--rule-strong);
    color: var(--ink);
    padding: 4px 10px;
    font: inherit;
    font-size: 0.75rem;
    cursor: pointer;
    border-radius: 0;
    transition: border-color 0.15s ease, background 0.15s ease, color 0.15s ease;
  }
  .chip:hover { border-color: var(--ink); }
  .chip.on {
    background: var(--ink);
    color: var(--bg);
    border-color: var(--ink);
  }

  .archive { padding-top: 0.25rem; }

  table.idx {
    width: 100%;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }
  table.idx thead th {
    text-align: left;
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    padding: 0.75rem 0.75rem 0.75rem 0;
    border-bottom: 1px solid var(--ink);
  }
  .col-date { width: 120px; }
  .col-tag { width: 130px; }

  @media (max-width: 640px) {
    .lede { padding: 2rem 0 1rem; }
    .lede p { font-size: 1.125rem; }
    table.idx thead { display: none; }
  }
</style>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('.chip');
  const rows = document.querySelectorAll<HTMLTableRowElement>('#archive-body .row');

  chips.forEach(chip => {
    chip.addEventListener('click', () => {
      const filter = chip.dataset.filter;
      chips.forEach(c => c.classList.toggle('on', c === chip));
      rows.forEach(row => {
        const cats = (row.dataset.categories ?? '').split(' ');
        const show = filter === 'all' || cats.includes(filter ?? '');
        row.style.display = show ? '' : 'none';
      });
    });
  });
</script>
