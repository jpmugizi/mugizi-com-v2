---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Stop from '../components/Stop.astro';
import { lines, monthsBetween, readingMinutes, type Category } from '../lib/lines';

type Entry = {
  title: string;
  date: Date;
  categories: Category[];
  description?: string;
  slug?: string;
  minutes?: number;
  externalUrl?: string;
  externalLabel?: string;
};

const externalPosts: Entry[] = [
  {
    title: 'Data Security and Stewardship at Baza In The Age of AI',
    date: new Date('2026-03-31'),
    categories: ['engineering'],
    externalUrl: 'https://www.usebaza.com/blog/data-security-stewardship',
  },
  {
    title: 'AI & Digital Tools for Energy and Transport Challenges',
    date: new Date('2026-05-25'),
    categories: ['engineering', 'career'],
    externalUrl: 'https://jpmugizi.github.io/epra-undp-talk/',
    externalLabel: 'EPRA x UNDP 2026 Conference & Hackathon',
  },
];

const posts = await getCollection('blog', ({ data }) => !data.draft);
const localEntries: Entry[] = posts.map((p) => ({
  title: p.data.title,
  date: p.data.date,
  categories: p.data.categories as Category[],
  description: p.data.description,
  slug: p.id,
  minutes: readingMinutes(p.body ?? ''),
}));

const entries = [...localEntries, ...externalPosts].sort((a, b) => b.date.valueOf() - a.date.valueOf());

// Space stops by time: longer silences between essays get a longer stretch of line.
const gapFor = (i: number) =>
  i === entries.length - 1 ? 1 : Math.min(6.5, 2.5 + monthsBetween(entries[i].date, entries[i + 1].date) * 0.2);
---

<BaseLayout title="Writing">
  <h1 class="sr-only">Writing</h1>

  <div class="lines-head" aria-hidden="true">
    <div class="bullets">
      {(Object.keys(lines) as Category[]).map((c) => <span class={`bullet ${c}`}>{lines[c].letter}</span>)}
    </div>
  </div>

  <ol class="stops" aria-label="Writing archive">
    {entries.map((entry, i) => (
      <Stop
        {...entry}
        showYear={i === 0 || entries[i - 1].date.getUTCFullYear() !== entry.date.getUTCFullYear()}
        gap={gapFor(i)}
      />
    ))}
  </ol>
</BaseLayout>

<style is:global>
  :root {
    --year-w: 4rem;
    --track-w: 9.5rem;
    --lane-0: 1.583rem;
    --lane-1: 4.75rem;
    --lane-2: 7.917rem;
  }
  @media (max-width: 720px) {
    :root {
      --year-w: 0px;
      --track-w: 6.5rem;
      --lane-0: 0.9rem;
      --lane-1: 3.2rem;
      --lane-2: 5.4rem;
    }
  }
</style>

<style>
  .lines-head { display: grid; grid-template-columns: var(--year-w) var(--track-w) 1fr; padding: 3rem 0 0.5rem; }
  .bullets { grid-column: 2; position: relative; height: 2.1rem; }
  .bullets .bullet { position: absolute; left: var(--l); transform: translateX(-50%); }
  .bullets .bullet.engineering { --l: var(--lane-0); }
  .bullets .bullet.career { --l: var(--lane-1); }
  .bullets .bullet.life { --l: var(--lane-2); }

  .stops { position: relative; margin: 0; padding: 0 0 6rem; list-style: none; }
  /* three continuous lines behind the stops, centered on the lane positions */
  .stops::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 var(--year-w);
    width: var(--track-w);
    /* the lines run on past the earliest essay and fade out instead of stopping */
    mask-image: linear-gradient(to bottom, #000 calc(100% - 5rem), transparent);
    background:
      linear-gradient(var(--eng), var(--eng)) calc(var(--lane-0) - 3px) 0 / 6px 100% no-repeat,
      linear-gradient(var(--career), var(--career)) calc(var(--lane-1) - 3px) 0 / 6px 100% no-repeat,
      linear-gradient(var(--life), var(--life)) calc(var(--lane-2) - 3px) 0 / 6px 100% no-repeat;
  }

  @media (max-width: 720px) {
    .lines-head { padding-top: 2rem; }
  }
</style>
