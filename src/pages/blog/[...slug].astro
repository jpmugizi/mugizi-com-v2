---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { lines, readingMinutes, titleParts, type Category } from '../../lib/lines';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const categories = post.data.categories as Category[];
const minutes = readingMinutes(post.body ?? '');
const dateLabel = post.data.date.toLocaleDateString('en-US', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
const lineNames = categories.map((c) => lines[c].name).join(' & ');
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="essay">
    <header class="essay-head">
      <p class="line-tag label">
        {categories.map((c) => <span class={`bullet ${c}`} aria-hidden="true">{lines[c].letter}</span>)}
        {lineNames}
      </p>
      <h1>{titleParts(post.data.title).map((part, i) => (i % 2 ? <span class="nw">{part}</span> : part))}</h1>
      {post.data.description && <p class="deck">{post.data.description}</p>}
      <p class="byline">
        <span>By <b>JP Mugizi</b></span>
        <time datetime={post.data.date.toISOString()}>{dateLabel}</time>
        <span>{minutes} min read</span>
      </p>
    </header>

    <nav class="toc" aria-label="Sections of this essay" hidden>
      <div class="toc-inner">
        <div data-toc-list></div>
      </div>
    </nav>

    <div class="body prose" data-post-body data-title={post.data.title}>
      <Content />
    </div>

    <p class="essay-foot"><a class="back label" href="/">Back to the line map</a></p>
  </article>
</BaseLayout>

<style>
  /* rail + text; the margin column only exists where notes and figures can use it */
  .essay {
    display: grid;
    grid-template-columns: 12.5rem minmax(0, 40rem);
    column-gap: 2.5rem;
    justify-content: center;
    padding-top: 2.75rem;
  }
  .essay-head { grid-column: 2; margin-bottom: 1.5rem; }
  @media (min-width: 1240px) {
    .essay { grid-template-columns: 12.5rem minmax(0, 40rem) 13rem; }
    .essay-head { grid-column: 2 / -1; }
  }

  .line-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0 0 1rem;
    color: var(--soft);
  }
  .line-tag .bullet { width: 1.6rem; height: 1.6rem; font-size: 0.9rem; }
  .line-tag .bullet:last-of-type { margin-right: 0.2rem; }

  h1 {
    max-width: 40rem;
    font-size: clamp(2.3rem, 5.4vw, 3.8rem);
    line-height: 1.04;
    letter-spacing: -0.012em;
  }
  .deck {
    max-width: 36rem;
    margin: 1.1rem 0 1.4rem;
    font-size: 1.35rem;
    line-height: 1.4;
    font-style: italic;
    color: var(--soft);
    text-wrap: pretty;
  }
  .byline {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 0;
    max-width: 40rem;
    margin: 0;
    padding: 0.7rem 0;
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--hair);
    font: 500 0.95rem/1.3 var(--font-label);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--soft);
  }
  .byline b { color: var(--ink); }
  .byline > :not(:last-child)::after { content: '\00b7'; margin: 0 0.7em; }

  .body { grid-column: 2; grid-row: 2; min-width: 0; }
  .toc { grid-column: 1; grid-row: 2; }
  .toc[hidden] { display: none; }
  .toc-inner { position: sticky; top: 2rem; }
  .toc :global(ol) { list-style: none; margin: 0; padding: 0; }
  .toc :global(li) { position: relative; padding: 0 0 1.35rem 1.75rem; }
  .toc :global(li:last-child) { padding-bottom: 0; }
  .toc :global(li::before) {
    content: '';
    position: absolute;
    left: 0.55rem;
    top: 0.8rem;
    bottom: -0.3rem;
    width: 4px;
    margin-left: -2px;
    background: var(--hair);
  }
  .toc :global(li:last-child::before) { display: none; }
  .toc :global(li.is-past::before) { background: var(--flag); }
  .toc :global(li::after) {
    content: '';
    position: absolute;
    left: 0.55rem;
    top: 0.3rem;
    width: 0.8rem;
    height: 0.8rem;
    margin-left: -0.4rem;
    border-radius: 50%;
    background: var(--paper);
    border: 3px solid var(--hair);
    transition: transform 0.25s var(--ease-out-quart);
  }
  .toc :global(li.is-past::after) { border-color: var(--flag); }
  .toc :global(li.is-active::after) { border-color: var(--flag); background: var(--flag); transform: scale(1.35); }
  .toc :global(button) {
    all: unset;
    cursor: pointer;
    font: 500 0.95rem/1.3 var(--font-label);
    letter-spacing: 0.02em;
    color: var(--soft);
  }
  .toc :global(li.is-active button) { color: var(--ink); font-weight: 700; }
  .toc :global(button:hover) { color: var(--flag); }
  .toc :global(button:focus-visible) { outline: 2px solid var(--flag); outline-offset: 3px; }

  .essay-foot { grid-column: 2; padding: 1.5rem 0 5rem; }
  .back { color: var(--flag); }
  .back:hover { text-decoration: underline; text-underline-offset: 4px; }

  @media (max-width: 1000px) {
    .essay { grid-template-columns: minmax(0, 40rem); }
    .essay-head, .body, .essay-foot { grid-column: 1; }
    .toc { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .toc :global(li::after) { transition: none; }
  }
</style>

<script>
  import { mountToc } from '../../scripts/toc';

  const body = document.querySelector<HTMLElement>('[data-post-body]');
  const toc = document.querySelector<HTMLElement>('.toc');
  if (body && toc) mountToc(toc, body, body.dataset.title ?? '');

  const maps = body?.querySelectorAll<HTMLElement>('[data-subway]') ?? [];
  if (maps.length) {
    import('../../scripts/subway').then((m) => maps.forEach((el) => m.mountSubway(el)));
  }
</script>
