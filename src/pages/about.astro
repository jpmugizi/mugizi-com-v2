---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About" description="About JP Mugizi - Software engineer focused on data, cloud infrastructure, and distributed systems.">
  <section class="about">
    <header class="about-header">
      <div class="photo-wrapper">
        <div class="photo-frame">
          <img
            src="/images/profile.png"
            alt="JP Mugizi"
            class="profile-photo"
          />
        </div>
        <div class="photo-decoration" aria-hidden="true"></div>
      </div>

      <div class="intro-content">
        <span class="intro-label">About</span>
        <h1 class="greeting">Hello, I'm JP Mugizi</h1>
        <p class="intro-text">
          Applied AI Engineer at
          <a href="https://gunder.com" target="_blank" rel="noopener">Gunderson Dettmer</a>.
        </p>
      </div>
    </header>

    <div class="about-body">
      <div class="section">
        <h2 class="section-title">Background</h2>
        <div class="section-content">
          <p>
            I believe analytics tools should empower people, not intimidate them. Throughout my career, I've built infrastructure that delivers real-time insights at scale, working with companies like Veho, Chipper Cash, Intuit Mailchimp, Boeing, and Login.gov.
          </p>
          <p>
            As Co-Founder & CTO of Baza Analytics, I focused on rethinking business intelligence from an African perspective, where the data problems and infrastructure constraints are fundamentally different. I'm now an Applied AI Engineer at Gunderson Dettmer.
          </p>
        </div>
      </div>

      <div class="section">
        <h2 class="section-title">Now</h2>
        <div class="section-content">
          <a href="https://gunder.com" target="_blank" rel="noopener" class="company-link featured">
            <div class="company-info">
              <span class="company-name">Gunderson Dettmer</span>
              <span class="company-role">Applied AI Engineer</span>
            </div>
          </a>
        </div>
      </div>

      <div class="section">
        <h2 class="section-title">Previously</h2>
        <div class="section-content">
          <ul class="company-list">
            <li>
              <a href="https://www.deepatlas.ai/" target="_blank" rel="noopener" class="company-link">
                <span class="company-name">Deep Atlas</span>
                <span class="company-role">Machine Learning and Applied AI intensive</span>
              </a>
            </li>
            <li>
              <a href="https://usebaza.com" target="_blank" rel="noopener" class="company-link">
                <span class="company-name">Baza Analytics</span>
                <span class="company-role">Co-Founder & CTO</span>
              </a>
            </li>
            <li>
              <a href="https://shipveho.com" target="_blank" rel="noopener" class="company-link">
                <span class="company-name">Veho Inc.</span>
                <span class="company-role">Senior Software Engineer</span>
              </a>
            </li>
            <li>
              <a href="https://chippercash.com" target="_blank" rel="noopener" class="company-link">
                <span class="company-name">Chipper Cash</span>
                <span class="company-role">Senior Software Engineer</span>
              </a>
            </li>
            <li>
              <a href="https://mailchimp.com" target="_blank" rel="noopener" class="company-link">
                <span class="company-name">Intuit Mailchimp</span>
                <span class="company-role">Senior Software Engineer</span>
              </a>
            </li>
            <li>
              <a href="https://capitalone.com" target="_blank" rel="noopener" class="company-link">
                <span class="company-name">Capital One</span>
                <span class="company-role">Senior Associate Software Engineer</span>
              </a>
            </li>
            <li>
              <a href="https://login.gov" target="_blank" rel="noopener" class="company-link">
                <span class="company-name">Login.gov</span>
                <span class="company-role">Software Engineer GS-15</span>
              </a>
            </li>
            <li>
              <a href="https://boeing.com" target="_blank" rel="noopener" class="company-link">
                <span class="company-name">Boeing</span>
                <span class="company-role">Software Developer</span>
              </a>
            </li>
          </ul>
        </div>
      </div>

      <div class="section connect-section">
        <h2 class="section-title">Connect</h2>
        <div class="contact-links">
          <a href="https://linkedin.com/in/mugizico" target="_blank" rel="noopener" class="contact-link">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
              <path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              <rect x="2" y="9" width="4" height="12" stroke="currentColor" stroke-width="1.5"/>
              <circle cx="4" cy="4" r="2" stroke="currentColor" stroke-width="1.5"/>
            </svg>
            LinkedIn
          </a>
          <a href="https://github.com/jpmugizi" target="_blank" rel="noopener" class="contact-link">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
              <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 00-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0020 4.77 5.07 5.07 0 0019.91 1S18.73.65 16 2.48a13.38 13.38 0 00-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 005 4.77a5.44 5.44 0 00-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 009 18.13V22" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            GitHub
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about { padding: 3.25rem 0 4rem; }

  .about-header {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 3rem;
    align-items: center;
    margin-bottom: 3.5rem;
    padding-bottom: 2.5rem;
    border-bottom: 3px solid var(--ink);
  }
  .photo-decoration { display: none; }
  .profile-photo {
    display: block;
    width: 180px;
    height: 180px;
    object-fit: cover;
    border: 1px solid var(--ink);
  }

  .intro-content { max-width: 34rem; }
  .intro-label { display: block; margin-bottom: 0.75rem; color: var(--flag); font: 700 0.82rem/1 var(--font-label); letter-spacing: 0.1em; text-transform: uppercase; }
  .greeting { margin: 0 0 1rem; font-size: clamp(2.2rem, 5vw, 3.4rem); line-height: 1.05; letter-spacing: -0.012em; }
  .intro-text { margin: 0; font-size: 1.28rem; line-height: 1.45; font-style: italic; color: var(--soft); }
  .intro-text a { color: var(--flag); text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; }

  .about-body { max-width: 40rem; }
  .section { margin-bottom: 3rem; }
  .section-title {
    margin: 0 0 1.1rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--ink);
    font-size: 1.65rem;
    font-style: italic;
  }
  .section-content { font-size: 1.22rem; line-height: 1.66; }
  .section-content p { margin: 0 0 1.2rem; text-wrap: pretty; }
  .section-content p:last-child { margin-bottom: 0; }

  .company-list { list-style: none; margin: 0; padding: 0; }
  .company-list li { border-bottom: 1px solid var(--hair); }
  .company-link {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.8rem 0;
  }
  .company-link.featured { flex-direction: column; align-items: flex-start; gap: 0.35rem; padding: 0.4rem 0 0; }
  .company-link.featured .company-info { display: flex; align-items: baseline; gap: 1rem; flex-wrap: wrap; }
  .company-name { font-weight: 600; }
  .company-link:hover .company-name { color: var(--flag); text-decoration: underline; text-underline-offset: 3px; }
  .company-role { font: 500 0.95rem/1.3 var(--font-label); letter-spacing: 0.04em; text-transform: uppercase; color: var(--soft); }
  .company-desc { font-size: 1.05rem; font-style: italic; color: var(--soft); }

  .contact-links { display: flex; gap: 1.5rem; flex-wrap: wrap; }
  .contact-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font: 500 1rem/1.3 var(--font-label);
    letter-spacing: 0.04em;
    border-bottom: 1px solid var(--ink);
    padding-bottom: 2px;
  }
  .contact-link:hover { color: var(--flag); border-color: var(--flag); }

  @media (max-width: 768px) {
    .about { padding: 2rem 0; }
    .about-header { grid-template-columns: 1fr; gap: 1.75rem; }
    .profile-photo { width: 150px; height: 150px; }
    .company-link { flex-direction: column; align-items: flex-start; gap: 0.15rem; }
  }
</style>
