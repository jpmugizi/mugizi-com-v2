---
import '../styles/global.css';

// Import all font options
import '@fontsource/geist-sans/400.css';
import '@fontsource/geist-sans/500.css';
import '@fontsource/geist-sans/600.css';
import '@fontsource/geist-mono/400.css';

import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/jetbrains-mono/400.css';

import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-mono/400.css';

import '@fontsource/source-sans-3/400.css';
import '@fontsource/source-sans-3/500.css';
import '@fontsource/source-sans-3/600.css';
import '@fontsource/fira-code/400.css';

import '@fontsource/roboto/400.css';
import '@fontsource/roboto/500.css';
import '@fontsource/roboto/700.css';
import '@fontsource/roboto-mono/400.css';

import '@fontsource/open-sans/400.css';
import '@fontsource/open-sans/500.css';
import '@fontsource/open-sans/600.css';

import '@fontsource/lato/400.css';
import '@fontsource/lato/700.css';

import '@fontsource/nunito-sans/400.css';
import '@fontsource/nunito-sans/600.css';

import '@fontsource/work-sans/400.css';
import '@fontsource/work-sans/500.css';
import '@fontsource/work-sans/600.css';

import '@fontsource/dm-sans/400.css';
import '@fontsource/dm-sans/500.css';
import '@fontsource/dm-sans/600.css';
import '@fontsource/dm-mono/400.css';

import '@fontsource/space-grotesk/400.css';
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/600.css';
import '@fontsource/space-mono/400.css';

import '@fontsource/manrope/400.css';
import '@fontsource/manrope/500.css';
import '@fontsource/manrope/600.css';

import '@fontsource/plus-jakarta-sans/400.css';
import '@fontsource/plus-jakarta-sans/500.css';
import '@fontsource/plus-jakarta-sans/600.css';

const fontOptions = [
  {
    name: '1. Inter + JetBrains Mono',
    description: 'The gold standard for tech. Clean, highly readable, universally loved.',
    sans: "'Inter', sans-serif",
    mono: "'JetBrains Mono', monospace",
  },
  {
    name: '2. Geist (Current)',
    description: 'Vercel\'s sleek font. Geometric, minimal, very 2024.',
    sans: "'Geist Sans', sans-serif",
    mono: "'Geist Mono', monospace",
  },
  {
    name: '3. IBM Plex',
    description: 'Corporate sophistication. Technical, authoritative, professional.',
    sans: "'IBM Plex Sans', sans-serif",
    mono: "'IBM Plex Mono', monospace",
  },
  {
    name: '4. Space Grotesk + Space Mono',
    description: 'Futuristic, bold, distinctive. Great for a unique identity.',
    sans: "'Space Grotesk', sans-serif",
    mono: "'Space Mono', monospace",
  },
  {
    name: '5. DM Sans + DM Mono',
    description: 'Google\'s geometric sans. Clean, modern, slightly playful.',
    sans: "'DM Sans', sans-serif",
    mono: "'DM Mono', monospace",
  },
  {
    name: '6. Plus Jakarta Sans + Fira Code',
    description: 'Elegant, contemporary. Popular with startups and modern brands.',
    sans: "'Plus Jakarta Sans', sans-serif",
    mono: "'Fira Code', monospace",
  },
  {
    name: '7. Manrope + JetBrains Mono',
    description: 'Semi-rounded, friendly yet professional. Warm and approachable.',
    sans: "'Manrope', sans-serif",
    mono: "'JetBrains Mono', monospace",
  },
  {
    name: '8. Work Sans + Fira Code',
    description: 'Optimized for screens. Neutral, versatile, works everywhere.',
    sans: "'Work Sans', sans-serif",
    mono: "'Fira Code', monospace",
  },
  {
    name: '9. Source Sans + Fira Code',
    description: 'Adobe\'s classic. Mature, readable, time-tested.',
    sans: "'Source Sans 3', sans-serif",
    mono: "'Fira Code', monospace",
  },
  {
    name: '10. Roboto + Roboto Mono',
    description: 'Google\'s workhorse. Familiar (Android/Material), very readable.',
    sans: "'Roboto', sans-serif",
    mono: "'Roboto Mono', monospace",
  },
  {
    name: '11. Open Sans + JetBrains Mono',
    description: 'Friendly, humanist. One of the most popular fonts on the web.',
    sans: "'Open Sans', sans-serif",
    mono: "'JetBrains Mono', monospace",
  },
  {
    name: '12. Lato + Fira Code',
    description: 'Warm, serious. Professional with a human touch.',
    sans: "'Lato', sans-serif",
    mono: "'Fira Code', monospace",
  },
  {
    name: '13. Nunito Sans + JetBrains Mono',
    description: 'Rounded, soft, approachable. Friendly without being childish.',
    sans: "'Nunito Sans', sans-serif",
    mono: "'JetBrains Mono', monospace",
  },
  {
    name: '14. System Fonts',
    description: 'Native OS fonts. Fastest load, most familiar to each user.',
    sans: "-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
    mono: "'SF Mono', 'Consolas', 'Monaco', monospace",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Font Comparison | mugizi</title>
  </head>
  <body>
    <div class="container">
      <header class="page-header">
        <a href="/" class="back-link">Back to blog</a>
        <h1>Font Comparison</h1>
        <p class="subtitle">Pick the font combination you like best</p>
      </header>

      {fontOptions.map((font, index) => (
        <section class="font-section" style={`--font-sans: ${font.sans}; --font-mono: ${font.mono};`}>
          <div class="font-header">
            <h2 class="font-name">{font.name}</h2>
            <p class="font-description">{font.description}</p>
          </div>

          <div class="font-preview">
            <div class="preview-block">
              <span class="label">Heading</span>
              <h3 class="preview-heading">Building Data Pipelines at Scale</h3>
            </div>

            <div class="preview-block">
              <span class="label">Body Text</span>
              <p class="preview-body">
                My name is JP Mugizi. I'm a software engineer with a focus on data,
                cloud infrastructure, and distributed systems. I was born and raised
                in Kigali, Rwanda but currently based out of Atlanta, GA.
              </p>
            </div>

            <div class="preview-block">
              <span class="label">Date & Category</span>
              <div class="preview-meta">
                <span class="preview-date">6 DEC 2024</span>
                <span class="preview-category">ENGINEERING</span>
              </div>
            </div>

            <div class="preview-block">
              <span class="label">Code</span>
              <pre class="preview-code"><code>const data = await getCollection('blog');
console.log("Found " + data.length + " posts");</code></pre>
            </div>

            <div class="preview-block">
              <span class="label">Inline Code</span>
              <p class="preview-inline">
                Use <code>pnpm dev</code> to start the server and <code>pnpm build</code> for production.
              </p>
            </div>
          </div>
        </section>
      ))}
    </div>
  </body>
</html>

<style>
  body {
    background-color: var(--bg-primary);
    color: var(--text-primary);
    padding: 2rem 0 4rem;
  }

  .page-header {
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border-color);
  }

  .back-link {
    font-size: 0.875rem;
    color: var(--accent);
    display: inline-block;
    margin-bottom: 1rem;
  }

  h1 {
    font-size: 2.5rem;
    margin: 0 0 0.5rem 0;
  }

  .subtitle {
    color: var(--text-secondary);
    margin: 0;
  }

  .font-section {
    margin-bottom: 3rem;
    padding: 2rem;
    background-color: var(--bg-secondary);
    border-radius: 12px;
    border: 1px solid var(--border-color);
  }

  .font-header {
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-color);
  }

  .font-name {
    font-size: 1.25rem;
    margin: 0 0 0.5rem 0;
    color: var(--accent);
  }

  .font-description {
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin: 0;
  }

  .font-preview {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .preview-block {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .label {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-secondary);
    font-family: var(--font-mono);
  }

  .preview-heading {
    font-family: var(--font-sans);
    font-size: 1.75rem;
    font-weight: 600;
    margin: 0;
    line-height: 1.3;
  }

  .preview-body {
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    line-height: 1.75;
    margin: 0;
    max-width: 600px;
  }

  .preview-meta {
    display: flex;
    gap: 1.5rem;
  }

  .preview-date,
  .preview-category {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-secondary);
    letter-spacing: 0.02em;
  }

  .preview-code {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    background-color: var(--bg-primary);
    padding: 1rem;
    border-radius: 8px;
    margin: 0;
    overflow-x: auto;
  }

  .preview-code code {
    font-family: inherit;
  }

  .preview-inline {
    font-family: var(--font-sans);
    font-size: 1rem;
    margin: 0;
  }

  .preview-inline code {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background-color: var(--bg-primary);
    padding: 0.2em 0.4em;
    border-radius: 4px;
  }
</style>
