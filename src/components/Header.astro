---
const pathname = Astro.url.pathname;
const isHome = pathname === '/';
const isAbout = pathname === '/about';
---

<header class="header">
  <div class="header-inner container">
    <a href="/" class="logo">
      <span class="logo-mark">mugizi.com</span>
      <span class="logo-sub">jp mugizi &middot; co-founder &amp; cto, baza analytics</span>
    </a>
    <nav class="nav" aria-label="Primary">
      <a href="/" class:list={['nav-link', { active: isHome }]}>writing</a>
      <a href="/about" class:list={['nav-link', { active: isAbout }]}>about</a>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: var(--bg);
    border-bottom: 1px solid var(--ink);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: var(--header-height);
    padding-top: 0.75rem;
    padding-bottom: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  .logo {
    display: flex;
    flex-direction: column;
    gap: 2px;
    color: var(--ink);
    line-height: 1.2;
  }
  .logo:hover { color: var(--mark); }
  .logo-mark { font-weight: 700; letter-spacing: 0.02em; }
  .logo-sub {
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 400;
  }

  .nav {
    display: flex;
    gap: 1.25rem;
  }
  .nav-link {
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    padding: 4px 2px;
    border-bottom: 1px solid transparent;
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .nav-link:hover { color: var(--mark); }
  .nav-link.active {
    color: var(--mark);
    border-bottom-color: var(--mark);
  }

  @media (max-width: 640px) {
    .logo-sub { display: none; }
    .header-inner { font-size: 0.75rem; }
  }
</style>
