---
interface Props {
  title: string;
  date: Date;
  category: string;
  slug: string;
  description?: string;
  index?: number;
}

const { title, date, category, slug, description, index = 0 } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  day: '2-digit',
  month: 'short',
  year: 'numeric'
});

const categoryColors: Record<string, string> = {
  engineering: 'var(--category-engineering)',
  career: 'var(--category-career)',
  life: 'var(--category-life)',
};

const categoryColor = categoryColors[category] || 'var(--terracotta)';
---

<article class="post-card" style={`--delay: ${index * 0.05}s; --category-color: ${categoryColor}`}>
  <a href={`/blog/${slug}`} class="post-link">
    <div class="post-meta">
      <span class="category-badge">{category}</span>
      <span class="date">{formattedDate}</span>
    </div>

    <h2 class="title">{title}</h2>

    {description && <p class="description">{description}</p>}

    <span class="read-more">
      Read article
      <svg class="arrow" width="16" height="16" viewBox="0 0 16 16" fill="none">
        <path d="M3 8H13M13 8L9 4M13 8L9 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </span>
  </a>
</article>

<style>
  .post-card {
    opacity: 0;
    animation: fadeIn 0.5s var(--ease-out-expo) forwards;
    animation-delay: var(--delay);
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .post-link {
    display: block;
    padding: 2rem 0;
    border-bottom: 1px solid var(--border-color);
    transition: all 0.3s var(--ease-out-quart);
    position: relative;
  }

  .post-link::before {
    content: '';
    position: absolute;
    left: -2rem;
    top: 0;
    bottom: 0;
    width: 3px;
    background-color: var(--category-color);
    opacity: 0;
    transform: scaleY(0);
    transition: all 0.3s var(--ease-out-expo);
    border-radius: 2px;
  }

  .post-link:hover {
    text-decoration: none;
    padding-left: 1.5rem;
  }

  .post-link:hover::before {
    opacity: 1;
    transform: scaleY(1);
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .category-badge {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--category-color);
    background-color: color-mix(in srgb, var(--category-color) 10%, transparent);
    padding: 0.25rem 0.625rem;
    border-radius: 3px;
    transition: all 0.2s ease;
  }

  .post-link:hover .category-badge {
    background-color: color-mix(in srgb, var(--category-color) 15%, transparent);
  }

  .date {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
    letter-spacing: 0.02em;
  }

  .title {
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 3vw, 1.75rem);
    font-weight: 400;
    color: var(--text-primary);
    margin: 0 0 0.5rem 0;
    line-height: 1.3;
    transition: color 0.2s ease;
  }

  .post-link:hover .title {
    color: var(--category-color);
  }

  .description {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    margin: 0 0 1rem 0;
    line-height: 1.6;
    max-width: 600px;
  }

  .read-more {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    transition: color 0.2s ease;
  }

  .post-link:hover .read-more {
    color: var(--category-color);
  }

  .arrow {
    transition: transform 0.3s var(--ease-out-expo);
  }

  .post-link:hover .arrow {
    transform: translateX(4px);
  }

  /* First post gets special treatment */
  .post-card:first-child .post-link {
    padding-top: 0;
  }

  .post-card:first-child .title {
    font-size: clamp(1.75rem, 4vw, 2.25rem);
  }
</style>
