---
interface Props {
  title: string;
  date: Date;
  category: string;
  slug?: string;
  externalUrl?: string;
  description?: string;
  index?: number;
}

const { title, date, category, slug, externalUrl } = Astro.props;

const isoDate = date.toISOString().slice(0, 10);
const isExternal = !!externalUrl;
const href = externalUrl ?? `/blog/${slug}`;
const externalHost = externalUrl ? new URL(externalUrl).hostname.replace(/^www\./, '') : '';
---

<tr class={`row ${isExternal ? 'row-external' : ''}`}>
  <td class="date"><time datetime={isoDate}>{isoDate}</time></td>
  <td class="title">
    {isExternal && (
      <span class="ext-kicker">
        <svg class="ext-icon" width="10" height="10" viewBox="0 0 12 12" aria-hidden="true">
          <path d="M3 3h6v6" stroke="currentColor" stroke-width="1.75" fill="none" stroke-linecap="round"/>
          <path d="M9 3L3 9" stroke="currentColor" stroke-width="1.75" fill="none" stroke-linecap="round"/>
        </svg>
        Cross-posted &middot; {externalHost}
      </span>
    )}
    <a
      href={href}
      target={isExternal ? '_blank' : undefined}
      rel={isExternal ? 'noopener noreferrer' : undefined}
    >{title}</a>
  </td>
  <td class={`tag tag-${category}`}>{category}</td>
</tr>

<style>
  .row { border-bottom: 1px dotted var(--rule-strong); }
  .row:hover { background-color: color-mix(in srgb, var(--mark) 6%, transparent); }

  td {
    padding: 0.875rem 0.75rem 0.875rem 0;
    vertical-align: top;
  }

  td.date {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--muted);
    white-space: nowrap;
    width: 120px;
    padding-top: 1rem;
    font-variant-numeric: tabular-nums;
  }

  td.title {
    font-family: var(--font-serif);
    font-size: 1.1875rem;
    line-height: 1.35;
  }
  td.title a {
    color: var(--ink);
    text-decoration: none;
  }
  td.title a:hover { color: var(--mark); }

  .ext-kicker {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--mark);
    margin-bottom: 0.25rem;
    line-height: 1;
  }
  .ext-icon {
    display: inline-block;
    vertical-align: -1px;
    margin-right: 0.375rem;
  }

  td.tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: lowercase;
    letter-spacing: 0.04em;
    width: 130px;
    padding-top: 1rem;
  }
  .tag-engineering { color: var(--pine); }
  .tag-career { color: var(--foam); }
  .tag-life { color: var(--gold); }

  @media (max-width: 640px) {
    td { display: block; padding-right: 0; }
    td.date { width: auto; padding: 0.875rem 0 0; }
    td.title { padding: 0.25rem 0; font-size: 1rem; }
    td.tag { padding: 0 0 0.875rem; width: auto; }
  }
</style>
