---
interface Props {
  title: string;
  date: Date;
  category: string;
  slug: string;
  description?: string;
  index?: number;
}

const { title, date, category, slug, description, index = 0 } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  day: '2-digit',
  month: 'short',
  year: 'numeric'
});

const categoryColors: Record<string, string> = {
  engineering: 'var(--category-engineering)',
  career: 'var(--category-career)',
  life: 'var(--category-life)',
};

const categoryColor = categoryColors[category] || 'var(--terracotta)';
---

<article class="post-card" style={`--delay: ${index * 0.05}s; --category-color: ${categoryColor}`}>
  <a href={`/blog/${slug}`} class="post-link">
    <div class="post-meta">
      <span class="category-badge">{category}</span>
      <span class="date">{formattedDate}</span>
    </div>

    <h2 class="title">{title}</h2>

    {description && <p class="description">{description}</p>}

    <span class="read-more">
      Read article
      <svg class="arrow" width="16" height="16" viewBox="0 0 16 16" fill="none">
        <path d="M3 8H13M13 8L9 4M13 8L9 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </span>
  </a>
</article>

<style>
  .post-card {
    opacity: 0;
    animation: fadeIn 0.5s var(--ease-out-expo) forwards;
    animation-delay: var(--delay);
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .post-link {
    display: block;
    padding: 1.25rem 1.5rem;
    margin: 0 -1.5rem;
    border-radius: 12px;
    border-bottom: none;
    transition: all 0.25s var(--ease-out-quart);
    position: relative;
    background-color: transparent;
  }

  .post-link:hover {
    text-decoration: none;
    background-color: var(--cream-dark);
    transform: translateY(-2px);
    box-shadow: 0 4px 20px rgba(15, 20, 25, 0.06);
  }

  .post-link:active {
    transform: translateY(0);
    box-shadow: 0 2px 8px rgba(15, 20, 25, 0.04);
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.375rem;
  }

  .category-badge {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--category-color);
    background-color: color-mix(in srgb, var(--category-color) 8%, transparent);
    padding: 0.1875rem 0.5rem;
    border-radius: 4px;
    transition: all 0.2s ease;
  }

  .post-link:hover .category-badge {
    background-color: color-mix(in srgb, var(--category-color) 18%, transparent);
  }

  .date {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
    letter-spacing: 0.02em;
  }

  .title {
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 2.5vw, 1.375rem);
    font-weight: 400;
    color: var(--text-primary);
    margin: 0;
    line-height: 1.35;
    transition: color 0.2s ease;
  }

  .post-link:hover .title {
    color: var(--category-color);
  }

  .description {
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin: 0.375rem 0 0 0;
    line-height: 1.5;
    max-width: 600px;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .read-more {
    display: none;
  }

  /* First post gets special treatment */
  .post-card:first-child .title {
    font-size: clamp(1.25rem, 3vw, 1.5rem);
  }

  .post-card:first-child .description {
    -webkit-line-clamp: 2;
  }

  /* Add subtle separator between cards */
  .post-card + .post-card {
    border-top: 1px solid var(--border-color);
    margin-top: 0.25rem;
    padding-top: 0.25rem;
  }
</style>
