---

---

<footer class="footer">
  <div class="footer-inner container">
    <div class="footer-top">
      <nav class="footer-nav">
        <a href="/" class="footer-link">Writings</a>
        <span class="nav-sep">/</span>
        <a href="/about" class="footer-link">About</a>
        <span class="nav-sep">/</span>
        <a href="https://linkedin.com/in/jpmugizi" target="_blank" rel="noopener" class="footer-link">LinkedIn</a>
        <span class="nav-sep">/</span>
        <a href="https://github.com/jpmugizi" target="_blank" rel="noopener" class="footer-link">GitHub</a>
      </nav>
    </div>

    <div class="footer-bottom">
      <span class="copyright">&copy; {new Date().getFullYear()} JP Mugizi</span>
      <div class="locations">
        <span class="location">
          <span class="flag">🇺🇸</span>
          Atlanta, GA
        </span>
        <span class="location-sep">/</span>
        <span class="location">
          <span class="flag">🇰🇪</span>
          Nairobi, KE
        </span>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    margin-top: auto;
    border-top: 1px solid var(--border-color);
  }

  .footer-inner {
    padding: 1.5rem 2rem;
  }

  .footer-top {
    display: flex;
    justify-content: center;
    margin-bottom: 1rem;
  }

  .footer-nav {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .footer-link {
    font-size: 0.8125rem;
    color: var(--text-secondary);
    transition: color 0.2s ease;
  }

  .footer-link:hover {
    color: var(--terracotta);
    text-decoration: none;
  }

  .nav-sep {
    color: var(--border-strong);
    font-size: 0.75rem;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1rem;
    border-top: 1px solid var(--border-color);
  }

  .copyright {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .locations {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .location {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .flag {
    font-size: 0.75rem;
  }

  .location-sep {
    color: var(--border-strong);
    font-size: 0.625rem;
  }

  @media (max-width: 480px) {
    .footer-inner {
      padding: 1.25rem;
    }

    .footer-bottom {
      flex-direction: column;
      gap: 0.5rem;
      text-align: center;
    }

    .locations {
      justify-content: center;
    }
  }
</style>
