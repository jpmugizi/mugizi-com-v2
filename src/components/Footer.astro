    gap: 2.5rem;
  }

  .footer-link {
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-primary);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 4px;
  }

  .footer-link:hover {
    color: var(--accent);
  }

  @media (max-width: 640px) {
    .footer-links {
      gap: 1.5rem;
      justify-content: center;
    }
  }
