---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-inner container">
    <span class="copy">&copy; {year} JP Mugizi</span>
    <nav class="footer-nav" aria-label="Footer">
      <a href="/" class="footer-link">writing</a>
      <a href="/about" class="footer-link">about</a>
      <a href="https://linkedin.com/in/mugizico" target="_blank" rel="noopener" class="footer-link">linkedin</a>
      <a href="https://github.com/jpmugizi" target="_blank" rel="noopener" class="footer-link">github</a>
    </nav>
  </div>
</footer>

<style>
  .footer {
    margin-top: auto;
    border-top: 1px solid var(--rule-strong);
  }
  .footer-inner {
    padding-top: 1.25rem;
    padding-bottom: 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
  }
  .copy { letter-spacing: 0.02em; }
  .footer-nav {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .footer-link {
    color: var(--ink);
    border-bottom: 1px dotted var(--rule-strong);
    padding-bottom: 1px;
  }
  .footer-link:hover { color: var(--mark); border-bottom-color: var(--mark); }
</style>
