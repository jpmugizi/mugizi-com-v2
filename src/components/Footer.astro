---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-inner wrap">
    <span>&copy; {year} JP Mugizi</span>
    <nav class="footer-nav" aria-label="Footer">
      <a href="/">Writing</a>
      <a href="/about">About</a>
      <a href="https://linkedin.com/in/mugizico" target="_blank" rel="noopener">LinkedIn</a>
      <a href="https://github.com/jpmugizi" target="_blank" rel="noopener">GitHub</a>
    </nav>
  </div>
</footer>

<style>
  .footer {
    margin-top: auto;
    border-top: 1px solid var(--hair);
  }
  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    padding: 0.75rem 0 1rem;
    font: 500 0.88rem/1.3 var(--font-label);
    letter-spacing: 0.04em;
    color: var(--soft);
  }
  .footer-nav { display: flex; gap: 1.2rem; flex-wrap: wrap; }
  .footer-nav a { padding: 0.6rem 0; color: var(--ink); text-decoration: underline var(--hair) 1px; text-underline-offset: 5px; }
  .footer-nav a:hover { color: var(--flag); text-decoration-color: var(--flag); }
</style>
